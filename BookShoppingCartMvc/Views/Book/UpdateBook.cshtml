@model BookViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "UpdateBook";
}

<div class="card shadow-sm border-0 mt-4" style="max-width:600px; margin:auto;">
    <div class="card-header text-white" style="background-color:#0b1e3d;">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Update Book</h5>
    </div>

    <div class="card-body">
        <a asp-action="Index" asp-controller="Book" class="btn btn-primary mb-3">
            <i class="bi bi-arrow-left"></i> Back
        </a>

        <form asp-action="UpdateBook" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />

            <div class="mb-3">
                <label class="form-label">Book Name*</label>
                <input type="text" class="form-control" asp-for="BookName" />
                <span asp-validation-for="BookName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Author Name*</label>
                <input type="text" class="form-control" asp-for="AuthorName" />
                <span asp-validation-for="AuthorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Genre*</label>
                <select class="form-control" asp-for="GenreId" asp-items="Model.GenreList">
                    <option value="">Select Genre</option>
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Price ($)*</label>
                <input type="number" class="form-control" asp-for="Price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Image*</label>
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-2">
                        <img src="/Images/@Model.Image" class="img-thumbnail book-img" />
                    </div>
                }
                <input type="file" class="form-control" asp-for="ImageFile" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="mb-3 text-end">
                <button type="submit" class="btn btn-info">
                    <i class="bi bi-pencil-square"></i> Update
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    img.book-img {
        width: 120px; /* تكبير الصورة */
        height: 90px; /* تكبير الصورة */
        object-fit: cover;
        border-radius: 4px;
    }

    .card input, .card select {
        width: 100%;
    }

    .card form .mb-3 {
        margin-bottom: 1rem;
    }

    .card button {
        min-width: 100px;
    }
</style>
