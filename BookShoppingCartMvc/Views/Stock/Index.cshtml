@model IEnumerable<StockDisplayModel>
@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Index";
}

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#0b1e3d;">
        <h5 class="mb-0">
            <i class="bi bi-archive"></i> Stock Management
        </h5>
    </div>

    <div class="card-body">
        <!-- Search -->
        <form asp-action="Index" method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" name="sterm" class="form-control"
                       placeholder="🔍 Search by book name" />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    Find
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index" asp-controller="Stock"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Book</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BookName</td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-center">
                                <a asp-action="ManagerStock"
                                   asp-controller="Stock"
                                   asp-route-bookId="@item.BookId"
                                   class="btn btn-sm btn-info">
                                    <i class="bi bi-pencil-square"></i> Update
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
