@model IEnumerable<Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Orders";
}

<div class="card shadow-sm border-0">
    <div class="card-header text-white" style="background-color:#0b1e3d;">
        <h5 class="mb-0"><i class="bi bi-receipt"></i> Orders</h5>
    </div>

    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.CreateDate.ToString("dd-MM-yyyy")</td>
                                <td>@order.Name</td>
                                <td>@order.Email</td>
                                <td>@order.Address</td>
                                <td>
                                    @order.PaymentMethod |
                                    <span class="badge @(order.IsPaid ? "bg-success" : "bg-warning text-dark")">
                                        @(order.IsPaid ? "Paid" : "Not Paid")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @order.OrderStatus.StatusName
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-primary mb-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#model-@order.Id">
                                        <i class="bi bi-eye"></i> Details
                                    </button>

                                    <a asp-action="UpdatePaymentStatus"
                                       asp-route-orderId="@order.Id"
                                       class="btn btn-sm btn-info mb-1">
                                        Change Status
                                    </a>

                                    <a asp-action="TogglePaymentStatus"
                                       asp-route-orderId="@order.Id"
                                       class="btn btn-sm btn-secondary mb-1">
                                        Toggle Payment
                                    </a>

                                    @await Html.PartialAsync(
                                             "/Views/AdminOperation/_OrderDetailModel.cshtml",
                                             new OrderDetailsViewModel
                            {
                                DivId = order.Id.ToString(),
                                OrderDetail = order.OrderDetails
                            })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <h5 class="text-center text-muted">No Orders Found</h5>
        }
    </div>
</div>
